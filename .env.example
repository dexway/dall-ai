# ── Public (safe in the browser) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only (never prefix with NEXT_PUBLIC_) ──
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# 32+ random characters, e.g. `openssl rand -base64 32`. Encrypts businesses' Paystack keys at rest.
ENCRYPTION_KEY=
# Dall AI's own Paystack account, for credit top-ups (platform billing). Use sk_test_ while testing.
PLATFORM_PAYSTACK_SECRET_KEY=
# Optional
AI_MODEL=claude-sonnet-5-5
# Set to "test" ONLY to run without an AI key; replies are labelled TEST MODE and cost nothing.
AI_PROVIDER=

# WhatsApp Cloud API (one Meta app serves every business; each business adds its own number in Settings)
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# optional, default v26.0
WHATSAPP_GRAPH_VERSION=

# Meta login for Embedded Signup (public IDs are safe in the browser; the app secret above is not)
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# Messenger and Instagram webhook verify token (any random word; the same value goes in the Meta app)
META_WEBHOOK_VERIFY_TOKEN=
