# Dall AI environment template. No real values here — copy to .env.local and fill in.
# Set the same variables in Vercel → Project → Settings → Environment Variables for production.

# ── Public (safe in the browser) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Meta app id (public) and the WhatsApp Embedded Signup configuration id
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# ── Server only (never prefix with NEXT_PUBLIC_, never log, never put in prompts) ──
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# 32+ random characters (`openssl rand -base64 32`). Encrypts every Meta and Paystack token at rest.
ENCRYPTION_KEY=
# Dall AI's own Paystack account, for credit top-ups. Use sk_test_ while testing.
PLATFORM_PAYSTACK_SECRET_KEY=

# ── Meta (one app serves every business) ──
# App secret: verifies every webhook signature and exchanges login codes.
META_APP_SECRET=
# Any random word; paste the same value into the Meta app's webhook settings.
WHATSAPP_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business configuration id ("Connect via Meta" one-screen flow). Optional:
# without it, login falls back to the scope list in lib/meta-oauth.ts.
META_LOGIN_CONFIG_ID=
# Optional, default v26.0
META_GRAPH_VERSION=
WHATSAPP_GRAPH_VERSION=

# ── Background jobs ──
# Vercel Cron sends this as a Bearer token to /api/cron/daily (webhook retries + ads sync).
CRON_SECRET=

# ── Optional ──
AI_MODEL=claude-sonnet-5-5
AI_RECEIPT_MODEL=claude-sonnet-5-5
# "test" runs without an AI key (replies labelled TEST MODE). Never set in production.
AI_PROVIDER=
# Free early access: assistants reply without spending credits. Set "false" to start billing.
DALL_FREE_MODE=
# Free mode: max AI calls per business per day (default 800)
FREE_DAILY_AI_CALLS=
# Admin dashboard FX rate for cost display
ADMIN_NGN_PER_USD=

# Higgsfield (server-only). KEY_ID:KEY_SECRET from the Higgsfield console. Never commit the real value.
HF_CREDENTIALS=
